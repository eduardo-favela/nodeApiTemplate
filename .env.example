# Server Settings
PORT=3000

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=1h
MASTER_API_TOKEN=your_master_token_for_machine_to_machine_auth

# Database Configuration (SQL Server)
# Format: sqlserver://HOST:PORT;database=DB_NAME;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true;
DATABASE_URL="sqlserver://localhost:1433;database=my_db;user=sa;password=my_password;encrypt=true;trustServerCertificate=true;"
